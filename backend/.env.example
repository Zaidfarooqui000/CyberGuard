# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

PORT=5000

# MySQL (XAMPP default: user root, empty password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cyberguard_db

# Cloud MySQL (e.g. Aiven) – set DB_SSL=true and paste the CA certificate.
# In Vercel, paste the full PEM text (with line breaks) as the value.
DB_SSL=false
DB_CA_CERT=

# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# The Next.js frontend address(es) for CORS – comma-separated if more than one
CLIENT_URL=http://localhost:3000
